{
  "name": "todo-web",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "bun run --sequential --workspaces typecheck",
    "build": "bun run --sequential --workspaces build",
    "test": "bun run --sequential --workspaces test",
    "dev:frontend": "bun --filter @todo/frontend dev",
    "dev:api": "bun --filter @todo/api dev",
    "migration:run": "bun --filter @todo/api migration:run",
    "migration:revert": "bun --filter @todo/api migration:revert"
  },
  "packageManager": "bun@1.2.15",
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
